# WARNING: DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL.
# Copy this file to `.env` and fill in real values for local development.
# Never commit `.env`, `.env.local`, or any file containing actual secrets.

# --- Database Configuration ---
DB_NAME=triagenet
DB_USER=triagenet
DB_PASSWORD=triagenet_secret
DB_PORT=5432
DB_HOST=postgres

# --- Redis Telemetry & Cache ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Backend Service (Spring Boot) ---
BACKEND_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# --- Frontend Service (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# --- Reverse Proxy (Nginx) ---
NGINX_PORT=80

# --- Deployment (OCI Always Free ARM) ---
# Used by scripts/deploy.sh for automated staging deployment
# DEPLOY_HOST=ubuntu@129.153.x.x
# DEPLOY_DIR=~/triagenet
# DEPLOY_DOMAIN=triagenet.example.com
# DEPLOY_EMAIL=admin@example.com
# DEPLOY_SSH_KEY=~/.ssh/oci_arm_key
# DOCKER_REGISTRY=ghcr.io/pg300604
# IMAGE_TAG=latest
