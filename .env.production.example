# ============================================================
# DO NOT COMMIT REAL PRODUCTION SECRETS.
# ============================================================
# This is a production environment variable TEMPLATE.
# Copy to .env.production and fill in real values only on
# secured production hosts. Never commit secrets to version control.
# ============================================================

# --------------------------------------------------
# PostgreSQL 16
# --------------------------------------------------
DB_NAME=triagenet
DB_USER=triagenet
DB_PASSWORD=<CHANGE_TO_STRONG_PASSWORD>
DB_PORT=5432
DB_HOST=postgres

# --------------------------------------------------
# Redis 7
# --------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --------------------------------------------------
# Spring Boot
# --------------------------------------------------
BACKEND_PORT=8080
JWT_SECRET=<CHANGE_TO_256_BIT_HEX_SECRET>
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=https://YOUR_DOMAIN

# --------------------------------------------------
# Next.js
# --------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=https://YOUR_DOMAIN/api

# --------------------------------------------------
# Nginx & SSL
# --------------------------------------------------
NGINX_PORT=80
NGINX_SSL_PORT=443

# --------------------------------------------------
# Deployment (OCI ARM)
# --------------------------------------------------
DEPLOY_HOST=ubuntu@YOUR_SERVER_IP
DEPLOY_DIR=~/triagenet
DEPLOY_DOMAIN=YOUR_DOMAIN
DEPLOY_EMAIL=admin@YOUR_DOMAIN
DEPLOY_SSH_KEY=~/.ssh/oci_arm_key
DOCKER_REGISTRY=ghcr.io/pg300604
IMAGE_TAG=latest
