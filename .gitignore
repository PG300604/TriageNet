# ============================================
# TriageNet — Root .gitignore
# ============================================

# ──── OS Generated ────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ──── IDE / Editor ────
.vscode/
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.suo
*.user
*.userosscache
*.sln.docstates

# ──── Environment & Secrets ────
.env
.env.local
.env.*.local
*.env
!.env.example
!frontend/.env.example

# ──── Node.js / Frontend ────
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.tsbuildinfo

# ──── Java / Spring Boot Backend ────
backend/target/
backend/.mvn/
backend/*.jar
backend/*.war
backend/*.class
backend/logs/
backend/*.log
hs_err_pid*

# ──── Python / ML Pipeline ────
ml/__pycache__/
ml/*.pyc
ml/.ipynb_checkpoints/
ml/venv/
ml/.venv/
ml/env/
ml/*.egg-info/
ml/dist/
ml/build/
ml/models/*.pkl
ml/models/*.joblib

# ──── Docker ────
docker-compose.override.yml

# ──── Graphify Knowledge Graph (auto-generated) ────
graphify-out/

# ──── Gemini / Antigravity Agent State ────
.agents/
!.agents/rules/
!.agents/workflows/
.gemini/

# ──── Test Coverage & Reports ────
coverage/
*.lcov
htmlcov/
.nyc_output/
test-results/

# ──── Misc Build Artifacts ────
*.log
*.tmp
*.bak
*.orig
dist/
build/

# ──── Security Audit Reports & Local Overrides ────
SECURITY_AUDIT_REPORT.md
backend/src/main/resources/application-local.yml
